<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>


<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ru.fixbyte.controller.ProductManagerController" prefHeight="500.0" prefWidth="700.0">

    <!-- Верхняя панель -->
    <top>
        <VBox spacing="10" style="-fx-background-color: #34495e; -fx-padding:  15;">
            <Label text="Управление товарами" textFill="white">
                <font>
                    <Font name="Arial Bold" size="20"/>
                </font>
            </Label>
        </VBox>
    </top>

    <!-- Центральная часть -->
    <center>
        <VBox spacing="15" style="-fx-padding: 20;">

            <!-- Форма добавления/редактирования товара -->
            <GridPane hgap="10" vgap="10" style="-fx-background-color: #ecf0f1; -fx-padding: 15; -fx-background-radius: 5;">
                <columnConstraints>
                    <ColumnConstraints minWidth="100" prefWidth="120"/>
                    <ColumnConstraints minWidth="200" prefWidth="250"/>
                    <ColumnConstraints minWidth="100" prefWidth="120"/>
                    <ColumnConstraints minWidth="100" prefWidth="150"/>
                </columnConstraints>

                <Label text="Наименование:" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <font>
                        <Font size="14"/>
                    </font>
                </Label>
                <TextField fx:id="nameField" GridPane.columnIndex="1" GridPane.rowIndex="0"
                           promptText="Введите название"/>

                <Label text="Цена:" GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <font>
                        <Font size="14"/>
                    </font>
                </Label>
                <TextField fx:id="priceField" GridPane.columnIndex="3" GridPane.rowIndex="0"
                           promptText="0.00"/>

                <Label text="Единица измерения:" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <font>
                        <Font size="14"/>
                    </font>
                </Label>
                <ComboBox fx:id="unitComboBox" GridPane.columnIndex="1" GridPane.rowIndex="1"
                          prefWidth="250" editable="true"/>

                <HBox spacing="10" GridPane.columnIndex="2" GridPane.rowIndex="1"
                      GridPane.columnSpan="2" alignment="CENTER_RIGHT">
                    <Button fx:id="addProductButton" text="Добавить товар" prefWidth="130"
                            style="-fx-background-color: #27ae60; -fx-text-fill:  white; -fx-font-size: 13;">
                    </Button>
                    <Button fx:id="updateProductButton" text="Обновить" prefWidth="100"
                            style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-size: 13;"
                            disable="true">
                    </Button>
                    <Button fx:id="cancelButton" text="Отмена" prefWidth="100"
                            style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 13;">
                    </Button>
                </HBox>
            </GridPane>

            <!-- Таблица товаров -->
            <VBox VBox.vgrow="ALWAYS">
                <Label text="Список товаров" style="-fx-font-size: 16; -fx-font-weight: bold;">
                    <VBox.margin>
                        <Insets bottom="10"/>
                    </VBox.margin>
                </Label>

                <TableView fx:id="productsTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                        <TableColumn fx:id="nameColumn" text="Наименование" prefWidth="300"/>
                        <TableColumn fx:id="priceColumn" text="Цена" prefWidth="120"/>
                        <TableColumn fx:id="unitColumn" text="Ед.  изм." prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>

            <!-- Кнопки действий -->
            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button fx:id="editButton" text="Редактировать" prefWidth="130"
                        style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 13;">
                </Button>
                <Button fx:id="deleteButton" text="Удалить" prefWidth="100"
                        style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 13;">
                </Button>
            </HBox>

        </VBox>
    </center>

</BorderPane>