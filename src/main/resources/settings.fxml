<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane prefHeight="650.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ru.fixbyte.controller.SettingsController">

    <top>
        <VBox spacing="10" style="-fx-background-color:  #34495e; -fx-padding:  15;">
            <Label text="Настройки компании" textFill="white">
                <font>
                    <Font name="Arial Bold" size="20" />
                </font>
            </Label>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" style="-fx-background:  white;">
            <VBox spacing="15" style="-fx-padding: 20;">

                <Label style="-fx-font-weight: bold; -fx-font-size: 15px;" text="Основная информация" />

                <GridPane hgap="10" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints minWidth="150" prefWidth="150" />
                        <ColumnConstraints minWidth="350" prefWidth="400" />
                    </columnConstraints>

                    <Label text="Название компании:" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <font><Font size="13" /></font>
                    </Label>
                    <TextField fx:id="companyNameField" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="Адрес:" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <font><Font size="13" /></font>
                    </Label>
                    <TextArea fx:id="addressField" prefRowCount="3" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="Телефон:" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <font><Font size="13" /></font>
                    </Label>
                    <TextField fx:id="phoneField" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                    <Label text="ИНН:" GridPane.columnIndex="0" GridPane.rowIndex="3">
                        <font><Font size="13" /></font>
                    </Label>
                    <TextField fx:id="innField" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                    <Label text="Путь к логотипу:" GridPane.columnIndex="0" GridPane.rowIndex="4">
                        <font><Font size="13" /></font>
                    </Label>
                    <TextField fx:id="logoPathField" GridPane.columnIndex="1" GridPane.rowIndex="4" />
               <rowConstraints>
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
                  <RowConstraints />
               </rowConstraints>
                </GridPane>

                <Separator />

                <Label style="-fx-font-weight: bold; -fx-font-size: 15px;" text="Настройки интерфейса" />

                <HBox alignment="TOP_CENTER" prefHeight="31.0" prefWidth="545.0" spacing="10">
                    <Label style="-fx-font-weight: bold;" text="Размер главного окна:" />
                    <Label prefHeight="18.0" prefWidth="59.0" text="Ширина:" />
                    <TextField fx:id="windowWidthField" prefHeight="25.0" prefWidth="64.0" promptText="800" />
                    <Label text="Высота:" />
                    <TextField fx:id="windowHeightField" prefWidth="65" promptText="600" />
                </HBox>

                <Separator />

                <!-- Автосохранение чеков -->
                <Label style="-fx-font-weight: bold; -fx-font-size: 15;" text="Автоматическое сохранение чеков" />
                <HBox alignment="CENTER_LEFT" spacing="6">
                    <Label text="Папка для чеков:" />
                    <TextField fx:id="receiptDirField" prefWidth="240" promptText="C:/Чеки/" />
                    <Button fx:id="chooseReceiptDirButton" minWidth="30" onAction="#onChooseReceiptDir" text="..." />
                </HBox>
                <CheckBox fx:id="autoSaveReceiptsBox" text="Автоматически сохранять чек при печати" />

                <Separator />

                <Label style="-fx-font-weight: bold; -fx-font-size: 15px;" text="Дополнительные опции для чека" />
                <HBox spacing="12">
                    <CheckBox fx:id="showInnBox" text="Показывать ИНН" />
                    <CheckBox fx:id="showBuyerSignatureBox" text="Подпись покупателя" />
                </HBox>

                <Separator />

                <!-- Безопасность -->
                <Label style="-fx-font-weight: bold; -fx-font-size: 15px;" text="Безопасность" />
                <CheckBox fx:id="authEnabledBox" text="Включить авторизацию при запуске" />
                <GridPane hgap="10" vgap="10">
                    <columnConstraints>
                        <ColumnConstraints minWidth="150" prefWidth="150" />
                        <ColumnConstraints minWidth="200" prefWidth="250" />
                    </columnConstraints>
                    <Label text="Логин:" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <font><Font size="13" /></font>
                    </Label>
                    <TextField fx:id="authLoginField" GridPane.columnIndex="1" GridPane.rowIndex="0" promptText="admin" />
                    <Label text="Новый пароль:" GridPane.columnIndex="0" GridPane.rowIndex="1">
                        <font><Font size="13" /></font>
                    </Label>
                    <PasswordField fx:id="newPasswordField" GridPane.columnIndex="1" GridPane.rowIndex="1" promptText="Новый пароль" />
                    <Label text="Повторить пароль:" GridPane.columnIndex="0" GridPane.rowIndex="2">
                        <font><Font size="13" /></font>
                    </Label>
                    <PasswordField fx:id="confirmPasswordField" GridPane.columnIndex="1" GridPane.rowIndex="2" promptText="Повторите пароль" />
                    <rowConstraints>
                        <RowConstraints />
                        <RowConstraints />
                        <RowConstraints />
                    </rowConstraints>
                </GridPane>
                <Label fx:id="passwordStatusLabel" style="-fx-text-fill: red;" />

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10" style="-fx-padding: 15; -fx-background-color: #f5f5f5;">
            <Button fx:id="saveButton" onAction="#onSaveSettings" prefWidth="120" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 14;" text="Сохранить" />
            <Button fx:id="cancelButton" onAction="#onCancel" prefWidth="120" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-size: 14;" text="Отмена" />
        </HBox>
    </bottom>
</BorderPane>
